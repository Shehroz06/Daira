GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_ENABLED=true
# Client-side cap on Gemini calls per rolling 60s window — Diara falls back
# to Ollama proactively once this is hit, instead of waiting for Google to
# reject the request. Tune to your key's actual quota.
GEMINI_MAX_RPM=15

OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_EMBED_MODEL=nomic-embed-text

# auto | gemini | ollama
LLM_PROVIDER=auto

DIARA_NUM_THREADS=
DIARA_DEBUG=false

# Retrieval relevance thresholds
DIARA_MIN_COSINE=0.45
DIARA_MIN_BM25=1.0
